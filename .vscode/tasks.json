{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Netloop: build debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat assembleDebug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Netloop: install on device/emulator",
      "type": "shell",
      "command": ".\\gradlew.bat installDebug",
      "problemMatcher": []
    },
    {
      "label": "Netloop: launch app",
      "type": "shell",
      "command": "adb shell am start -n com.netloop.game/.MainActivity",
      "problemMatcher": []
    },
    {
      "label": "Netloop: install + launch",
      "dependsOrder": "sequence",
      "dependsOn": ["Netloop: install on device/emulator", "Netloop: launch app"],
      "problemMatcher": []
    },
    {
      "label": "Netloop: start emulator",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\emulator\\emulator.exe\" -avd Netloop_Pixel",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Netloop: regenerate sprites",
      "type": "shell",
      "command": "python tools/sprites/generate_sprites.py",
      "problemMatcher": []
    },
    {
      "label": "Netloop: show logs",
      "type": "shell",
      "command": "adb logcat --pid=$(adb shell pidof -s com.netloop.game)",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
